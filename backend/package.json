{
  "name": "@queuepilot/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "validate": "sam validate --lint --template-file template.yaml --region us-east-1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@queuepilot/shared": "0.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.3"
  }
}
