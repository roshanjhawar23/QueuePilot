{
  "rules": [
    {
      "field": "customer_id",
      "required": true,
      "type": "string"
    },
    {
      "field": "name",
      "required": true,
      "type": "string"
    },
    {
      "field": "email",
      "required": true,
      "type": "email"
    },
    {
      "field": "age",
      "required": true,
      "type": "integer",
      "min": 18,
      "max": 120
    },
    {
      "field": "signup_date",
      "required": true,
      "type": "date"
    },
    {
      "field": "plan",
      "required": true,
      "allowedValues": [
        "basic",
        "pro",
        "enterprise"
      ]
    },
    {
      "field": "monthly_spend",
      "type": "number",
      "min": 0,
      "max": 10000
    }
  ]
}